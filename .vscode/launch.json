{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AUTOX",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env.example.json"]
    },
    {
      "name": "AUTOX (web, port 8080)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=env.example.json", "--web-port=8080"]
    }
  ]
}
